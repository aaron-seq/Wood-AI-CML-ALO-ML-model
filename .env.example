# Copy to .env and adjust. Every value here is a default that already
# works for local development -- .env is only needed to override one.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit real credentials.

# --- API metadata ---------------------------------------------------------
API_TITLE=Wood AI CML Optimization API
API_VERSION=1.0.0
ENVIRONMENT=development

# --- Server ---------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# --- CORS -----------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
# "*" is rejected at startup: list the dashboard origins explicitly.
# In production this must name your real dashboard host over HTTPS.
CORS_ORIGINS=http://localhost:8501

# --- Model and data paths -------------------------------------------------
# Relative paths resolve against the repository root.
MODEL_DIR=models
MODEL_FILENAME=cml_elimination_model.joblib
DATA_DIR=data
SME_OVERRIDE_FILE=data/sme_overrides.json

# --- Engineering defaults -------------------------------------------------
# Minimum allowable wall thickness used by the API 570 remaining-life
# calculation, and the safety factor applied to inspection intervals.
DEFAULT_MINIMUM_THICKNESS=3.0
DEFAULT_INSPECTION_INTERVAL=36
SAFETY_FACTOR=1.5

# --- Feature engineering thresholds ---------------------------------------
HIGH_CORROSION_THRESHOLD=0.15
THIN_WALL_THRESHOLD=8.0

# --- Model training -------------------------------------------------------
TEST_SIZE=0.2
RANDOM_STATE=42
CV_FOLDS=5

# --- Upload limits --------------------------------------------------------
# Uploads are parsed in memory, so MAX_UPLOAD_BYTES is the effective
# per-request memory ceiling. Raise both together, and size your
# container's memory limit accordingly.
MAX_UPLOAD_BYTES=26214400
MAX_UPLOAD_ROWS=100000

# Scored rows echoed in a response body. The true count is always
# reported as total_results, with results_truncated set when it differs.
MAX_RESULTS_IN_RESPONSE=100

# --- Authentication -------------------------------------------------------
# Unset means no authentication, which is the default and preserves the
# historical behaviour. Set it and callers must send an X-API-Key header.
# Must be at least 16 characters; a guessable key is refused at startup.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# API_KEY=

# "writes": only endpoints that mutate the SME audit trail are gated.
# "all":    scoring, reporting and metadata are gated too.
# / and /health are never gated -- an orchestrator cannot authenticate a probe.
API_KEY_SCOPE=writes

# --- Logging and metrics --------------------------------------------------
LOG_LEVEL=INFO
# "text" is human-readable; "json" emits one structured object per line
# for a log aggregator, carrying request_id, path, status and duration.
LOG_FORMAT=text

# Serve Prometheus metrics at /metrics. Off by default: it reveals traffic
# volume and should be scraped from inside the network, not a public ingress.
METRICS_ENABLED=false

# --- Dashboard ------------------------------------------------------------
# Where the Streamlit dashboard looks for the API. Under Docker Compose
# this is set to http://api:8000 automatically.
CML_API_URL=http://localhost:8000
# Must match the API's API_KEY when one is configured.
# CML_API_KEY=
